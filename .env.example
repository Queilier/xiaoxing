# 从 OpenAI API 平台创建的密钥，仅放在服务端，不要放进前端代码。
OPENAI_API_KEY=your_openai_api_key_here

# 可选项
TTS_PROVIDER=doubao
DOUBAO_API_KEY=
DOUBAO_TTS_VOICE=zh_female_linjianvhai_uranus_bigtts
# 需要使用原 OpenAI 配音时，将 TTS_PROVIDER 改为 openai。
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
PORT=3000
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# macOS 本地启动会自动使用系统 HTTPS 代理；云端默认直连。
# 如需手动指定代理，可取消下一行注释；设为 direct 可禁用代理。
# OPENAI_PROXY_URL=http://127.0.0.1:7890
